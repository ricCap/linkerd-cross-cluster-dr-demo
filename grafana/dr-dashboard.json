            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "unit": "short",
          "noValue": "BEL only \u2014 no HAZL metrics on this install"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster) (outbound_http_balancer_adaptive_endpoints{parent_name=\"app-federated\"})",
          "legendFormat": "available \u2014 {{cluster}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
